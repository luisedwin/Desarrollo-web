# Copia este archivo como ".env" (en esta misma carpeta) y llena tus datos de Supabase.
# Supabase > tu proyecto > botón "Connect" > pestaña "Session pooler".
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=tu_contraseña_de_la_base_de_datos

# Clave secreta para firmar los tokens de sesión (JWT). Mínimo 32 caracteres, aleatoria.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria_de_32+_caracteres

# Cuenta de administrador que se crea al arrancar (solo si todavía no existe ninguna)
ADMIN_EMAIL=admin@biblioteca.com
ADMIN_PASSWORD=cambia_esta_contraseña
